# URL pública del micrositio (canonical, sitemap y protección CSRF del login).
# En producción tiene que estar disponible también al compilar (variable de build).
SITE_URL=https://licitaciones.municipio.gob.ar

# Solo para el primer arranque (si la base no tiene usuarios). Borrar ADMIN_CLAVE después.
ADMIN_NOMBRE=
ADMIN_EMAIL=
ADMIN_CLAVE=

# Carpeta persistente: base SQLite, documentos, marca y backups.
# En local, por defecto ./data. En Docker la imagen ya usa /data (el volumen): no la cambies ahí.
# DATA_DIR=./data

# Solo si TODO el tráfico llega a través de un proxy que manda la IP real del visitante
# (por ejemplo Cloudflare: cf-connecting-ip). Sin proxy, dejala vacía: la cabecera se podría falsificar.
# CABECERA_IP_CLIENTE=cf-connecting-ip
