---
import '../styles/global.css';
import Header from '../components/marca/Header.astro';
import Footer from '../components/marca/Footer.astro';
import Cabeza from '../components/marca/Cabeza.astro';

interface Props {
  titulo: string;
  descripcion: string;
  /** JSON-LD opcional para la ficha. */
  datosEstructurados?: Record<string, unknown>;
}
const { titulo, descripcion, datosEstructurados } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const { nombre } = Astro.locals.sitio;
const tituloCompleto = titulo === 'Licitaciones' ? `Licitaciones | ${nombre}` : `${titulo} | Licitaciones | ${nombre}`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <Cabeza />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_AR" />
    <meta name="theme-color" content="#202124" />
    {datosEstructurados && <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenido" class="sr-only z-50 rounded bg-white px-4 py-2 font-semibold focus:not-sr-only focus:fixed focus:top-2 focus:left-2">
      Ir al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { mejorarControles } from '../scripts/controles';
      mejorarControles();
    </script>
  </body>
</html>
