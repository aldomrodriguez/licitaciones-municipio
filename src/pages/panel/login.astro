---
import '../../styles/global.css';
import { db } from '../../lib/db';
import { guardarCookie, iniciarSesion } from '../../lib/auth';
import { altoPara, urlImagen } from '../../lib/configuracion';
import Cabeza from '../../components/marca/Cabeza.astro';
import { destinoDespuesDeLogin, ipCliente } from '../../lib/seguridad';
import { limiteLogin, textoEspera } from '../../lib/limite-intentos';

const volver = destinoDespuesDeLogin(Astro.url.searchParams.get('volver'));
let error = '';
let email = '';

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  email = String(datos.get('email') ?? '');
  const ip = ipCliente(Astro.request.headers, Astro.clientAddress);
  // El límite se chequea antes de verificar la clave: así un ataque no consume CPU con argon2.
  const espera = limiteLogin.espera(ip, email);
  if (espera > 0) {
    error = textoEspera(espera);
    Astro.response.status = 429;
    Astro.response.headers.set('Retry-After', String(Math.ceil(espera / 1000)));
  } else {
    const r = await iniciarSesion(db(), email, String(datos.get('clave') ?? ''));
    if (r) {
      limiteLogin.registrarExito(ip, email);
      guardarCookie(Astro.cookies, r.token);
      return Astro.redirect(r.usuario.debeCambiarClave ? '/panel/cuenta' : volver, 303);
    }
    limiteLogin.registrarFallo(ip, email);
    error = 'El email o la contraseña no son correctos.';
    Astro.response.status = 401;
  }
}
if (Astro.locals.usuario) return Astro.redirect('/panel');
const sitio = Astro.locals.sitio;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ingresar | Panel de licitaciones</title>
    <Cabeza />
  </head>
  <body class="grid min-h-dvh place-items-center bg-tinta px-4 py-10">
    <main class="w-full max-w-[400px]">
      {
        sitio.logo ? (
          <img src={urlImagen(sitio.logo)} alt={sitio.nombre} width="160" height={altoPara(sitio.logo, 160)} class="mx-auto mb-8 max-h-[100px] w-[150px] object-contain" />
        ) : (
          <p class="mb-8 text-center text-2xl font-bold text-white">{sitio.nombre}</p>
        )
      }
      <div class="rounded-xl border-t-4 border-marca bg-white p-7 shadow-2xl">
        <h1 class="text-2xl font-bold tracking-tight">Panel de licitaciones</h1>
        <p class="mt-1 text-gris">Ingresá con tu usuario del área de Compras.</p>
        {
          error && (
            <p class="mt-5 rounded-md bg-peligro-fondo px-3 py-2 text-sm text-peligro" role="alert" id="error-login">
              {error}
            </p>
          )
        }
        <form method="post" class="mt-6 space-y-4">
          <div>
            <label for="email" class="etiqueta">Email</label>
            <input id="email" name="email" type="email" required autocomplete="username" value={email} class="campo" aria-invalid={error ? 'true' : undefined} aria-describedby={error ? 'error-login' : undefined} autofocus />
          </div>
          <div>
            <label for="clave" class="etiqueta">Contraseña</label>
            <input id="clave" name="clave" type="password" required autocomplete="current-password" class="campo" aria-invalid={error ? 'true' : undefined} />
          </div>
          <button type="submit" class="btn-primario w-full py-3">Ingresar</button>
        </form>
      </div>
      <p class="mt-6 text-center text-sm text-white/60">¿Olvidaste la contraseña? Pedile a un administrador que la restablezca.</p>
    </main>
  </body>
</html>
