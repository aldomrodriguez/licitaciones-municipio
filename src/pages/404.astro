---
import Publico from '../layouts/Publico.astro';
Astro.response.status = 404;
---

<Publico titulo="Página no encontrada" descripcion="El procedimiento o la página que buscás no existe.">
  <div class="contenedor py-24">
    <p class="cifras text-[88px] leading-none font-extrabold tracking-[-.05em] text-rojo">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight">No encontramos esta página</h1>
    <p class="mt-3 max-w-[560px] text-gris">Puede que el procedimiento todavía no esté publicado o que la dirección esté mal escrita.</p>
    <a href="/" class="btn-primario mt-8">Ver todas las licitaciones</a>
  </div>
</Publico>
