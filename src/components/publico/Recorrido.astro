---
/** Pasos del procedimiento según la modalidad, marcando dónde está. */
import type { Tipo } from '../../lib/db/schema';
import { ESTADOS, type Estado } from '../../lib/estados';

interface Props {
  tipo: Tipo;
  estado: Estado;
}
const { tipo, estado } = Astro.props;
// Las privadas van del borrador al resultado; solo las importadas siguen «En trámite».
const camino: Estado[] =
  tipo === 'publica' ? ['llamado', 'evaluacion'] : tipo === 'privada' && estado !== 'tramite' ? [] : ['tramite'];
const cierre: Estado = ESTADOS[estado].final ? estado : 'adjudicada';
const pasos = [...camino, cierre];
const actual = pasos.indexOf(estado);
const cortado = ESTADOS[estado].final && estado !== 'adjudicada';
---

{/* Con una sola etapa (privadas con resultado) el recorrido repetiría el estado: no se muestra. */}
{pasos.length > 1 && (
<ol class="flex" aria-label="Etapas del procedimiento">
  {
    pasos.map((p, i) => {
      const hecho = i < actual;
      const ahora = i === actual;
      return (
        <li class="flex min-w-0 flex-1 flex-col items-start gap-2">
          <div class="flex w-full items-center">
            <span
              class:list={[
                'cifras grid size-8 shrink-0 place-items-center rounded-full border-2 text-sm font-bold',
                hecho && 'border-tinta bg-tinta text-white',
                ahora && !cortado && 'border-marca bg-marca text-white',
                ahora && cortado && 'border-peligro bg-peligro text-white',
                !hecho && !ahora && 'border-linea bg-white text-gris',
              ]}
            >
              {i + 1}
            </span>
            {i < pasos.length - 1 && <span class:list={['h-0.5 flex-1', hecho ? 'bg-tinta' : 'bg-linea']} aria-hidden="true" />}
          </div>
          <span class:list={['pr-2 text-[13px] leading-snug sm:text-sm', ahora ? 'font-bold text-tinta' : 'text-gris']}>
            {ESTADOS[p].nombre}
            {ahora && <span class="sr-only"> (etapa actual)</span>}
          </span>
        </li>
      );
    })
  }
</ol>
)}
